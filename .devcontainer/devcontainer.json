{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  // The frontend is a Vite/React app, so the container needs Node to build it.
  // `scripts/serve.py` shells out to npm.
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "api/main.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // requirements-dev.txt pulls in requirements.txt, so this one file installs
  // both the app and the test tooling.
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; pip3 install --user -r requirements-dev.txt; npm install --prefix web; echo 'Packages installed and requirements met'",
  // Builds web/dist and then serves it and the API from one port. The build has
  // to finish before the app is imported, which is what the script is for.
  "postAttachCommand": {
    "server": "python3 -m scripts.serve --host 0.0.0.0 --port 8000"
  },
  "portsAttributes": {
    "8000": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000
  ]
}
