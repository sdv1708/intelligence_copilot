# Executive Intelligence Copilot - Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================
# Choose one: gemini, openai, or anthropic
LLM_PROVIDER=gemini

# ============================================================================
# API KEYS (Required based on LLM_PROVIDER)
# ============================================================================

# Google Gemini API Key
# Get yours at: https://makersuite.google.com/app/apikey
# Free tier available with generous limits
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (if using OpenAI)
# Get yours at: https://platform.openai.com/api-keys
# Requires payment
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (if using Anthropic Claude)
# Get yours at: https://console.anthropic.com/
# Requires payment
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# MODEL SELECTION (Optional)
# ============================================================================
# Defaults are the current generation of each provider. Override only if you
# want a specific model -- and check the provider's docs first: model ids are
# retired on a schedule, and a retired id is a 404, not a warning.
#
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.5-flash

# Sampling temperature. Ignored for models that no longer accept it
# (Claude Opus 4.7 and later, Claude Sonnet 5, the GPT-5 family), which reject
# the parameter outright rather than ignoring it.
# LLM_TEMPERATURE=0.3

# Output token cap per request. Covers reasoning tokens as well as the answer
# on models that think before replying, so leave headroom.
# LLM_MAX_TOKENS=16000

# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=2

# ============================================================================
# STORAGE CONFIGURATION (Optional)
# ============================================================================

# Database path (default: ./data/briefs.db)
# DB_PATH=./data/briefs.db

# FAISS index path (default: ./data/faiss)
# FAISS_PATH=./data/faiss

# Raw files storage path (default: ./data/raw)
# RAW_PATH=./data/raw

# ============================================================================
# DEPLOYMENT CONFIGURATION (Optional)
# ============================================================================

# Ngrok authtoken (for Colab deployment)
# Get yours at: https://dashboard.ngrok.com/signup
# Only needed if running on Colab with ngrok
NGROK_TOKEN=your_ngrok_token_here

# ============================================================================
# PERFORMANCE TUNING (Advanced)
# ============================================================================

# Embedding batch size (default: auto-detected based on device)
# EMBEDDING_BATCH_SIZE=32

# Max document size in MB (default: 200)
# MAX_UPLOAD_SIZE=200

# ============================================================================
# NOTES
# ============================================================================
#
# Recommended LLM Provider:
# - Gemini: Best for most users (free tier, fast, good quality)
# - OpenAI: Best quality, requires paid account
# - Anthropic: Alternative to OpenAI, requires paid account
#
# For local development:
# 1. Copy this file: cp env.example .env
# 2. Fill in your API keys
# 3. Choose your LLM_PROVIDER
# 4. Run: streamlit run app.py
#
# For Colab deployment:
# - API keys are entered interactively in the notebook
# - No .env file needed
#
# For Hugging Face Spaces:
# - Set secrets in Space Settings → Repository secrets
# - Do NOT upload .env file to public repos
#
# ============================================================================

