# Environment variables
.env
.env.local
.env.*.local

# Python — caches and compiled artefacts, at any depth
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Python — virtualenvs and packaging output.
#
# Every one of these is anchored with a leading slash, and that matters. An
# unanchored `lib/` or `dist/` matches a directory of that name at *any* depth,
# which used to mean a `web/src/lib/` full of frontend source was silently
# untracked — `git add` reported success and committed nothing. Keep the slashes.
/.venv/
/env/
/venv/
/ENV/
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Frontend build output is ignored by web/.gitignore, next to what it describes.

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Data and database
data/briefs.db
data/briefs.db-wal
data/briefs.db-shm
data/briefs.backup-*.db
data/faiss/*.index
data/faiss/*.faiss
data/raw/*
!data/raw/.gitkeep
!data/faiss/.gitkeep

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS
Thumbs.db
